---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MarqueeBar from "../components/MarqueeBar.astro";
import Hero from "../components/home/Hero.astro";
import StatsStrip from "../components/home/StatsStrip.astro";
import BentoIntro from "../components/home/BentoIntro.astro";
import FeaturedEvents from "../components/home/FeaturedEvents.astro";
import DialoguesTeaser from "../components/home/DialoguesTeaser.astro";
import JoinCTA from "../components/home/JoinCTA.astro";

const events = (await getCollection("events")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = events.filter((e) => e.data.featured).slice(0, 3);
const picked = featured.length >= 3 ? featured : events.slice(0, 3);

const dialogues = (await getCollection("dialogues")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const guests = new Set<string>();
for (const e of events) if (e.data.guest) guests.add(e.data.guest);
for (const d of dialogues) guests.add(d.data.interviewee);

const years = new Set(
  [...events, ...dialogues].map((c) => c.data.date.getFullYear()),
);
const yearSpan = years.size > 0 ? `${Math.min(...years)}` : "2025";
---

<Base>
  <Hero />
  <MarqueeBar />
  <StatsStrip
    eventCount={events.length}
    guestCount={guests.size}
    yearSpan={String(yearSpan)}
  />
  <BentoIntro />
  <FeaturedEvents events={picked} />
  <DialoguesTeaser dialogues={dialogues.slice(0, 2)} />
  <JoinCTA />
</Base>
