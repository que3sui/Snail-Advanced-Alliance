---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const dialogues = (await getCollection("dialogues")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return dialogues.map((dialogue) => ({
    params: { slug: dialogue.id },
    props: { dialogue },
  }));
}

const { dialogue } = Astro.props;
const { Content } = await render(dialogue);
const dateStr = dialogue.data.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
});
---

<Base
  title={`${dialogue.data.title} — 蜗壳进阶联盟`}
  description={dialogue.data.summary}
>
  <article class="pt-12">
    <p class="nb-tag bg-sky mb-4 inline-block">深度访谈</p>
    <h1 class="font-display text-3xl leading-tight font-black sm:text-5xl">
      {dialogue.data.title}
    </h1>
    <p
      class="border-2.5 border-ink bg-lemon mt-4 inline-block px-3 py-1.5 font-bold"
    >
      对谈：{dialogue.data.interviewee} · {dialogue.data.intervieweeTitle}
    </p>
    <p class="mt-2 font-mono text-sm opacity-60">{dateStr}</p>

    <div
      class="nb-card prose prose-neutral mt-8 max-w-none bg-white p-6 sm:p-10"
    >
      <Content />
    </div>
  </article>
</Base>
