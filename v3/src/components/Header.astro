---
import { SITE_NAME } from "../lib/constants";

const links = [
  { href: "/events/", label: "活动" },
  { href: "/dialogues/", label: "访谈" },
  { href: "/about/", label: "关于" },
  { href: "/join/", label: "加入" },
];
const base = import.meta.env.BASE_URL;
const { path = Astro.url.pathname } = Astro.props as { path?: string };
---

<header
  class="border-b-2.5 border-ink bg-paper/95 sticky top-0 z-50 backdrop-blur"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3.5">
    <a href={base} class="flex items-center gap-2 no-underline">
      <img
        src={`${base}mascot/snail.svg`}
        alt=""
        class="h-8 w-8 transition-transform hover:rotate-12"
      />
      <span class="font-display text-lg font-black tracking-wide"
        >{SITE_NAME}</span
      >
    </a>
    <nav class="flex items-center gap-1 sm:gap-2">
      {
        links.map(({ href, label }) => {
          const full = base.replace(/\/$/, "") + href;
          const active = path.startsWith(full);
          return (
            <a
              href={full}
              class:list={[
                "border-2 px-2 py-1 font-mono text-sm font-bold no-underline transition-colors",
                active
                  ? "border-ink bg-snail text-paper"
                  : "hover:border-ink hover:bg-lemon border-transparent",
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
